options {
    directory "/var/cache/bind";

    recursion yes;

    dnssec-validation no;

    allow-query {
        10.10.0.0/24;
    };

    allow-recursion {
        10.10.0.0/24;
    };

    allow-query-cache {
        10.10.0.0/24;
    };

    listen-on {
        10.10.0.2;
    };

    listen-on-v6 {
        none;
    };
};
